  m_Script: {fileID: 11500000, guid: 9ebe144831fe4517acf27321fd74b37d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableNote
  requiredDrawer: {fileID: 1087417073}
  popupRoot: {fileID: 1362262815}
  popupText: {fileID: 882314714}
  clueText: "L\u2019imprimante garde la suite du secret, mais son bac est vide.\n\nR\xE9cup\xE8re
    la feuille dans le parcours derri\xE8re les grilles, puis d\xE9pose-la dans l\u2019imprimante.
    Elle te livrera le prochain indice.\n\nPour fermer, vise \xAB Fermer \xBB et
    appuie sur la g\xE2chette de tir."
